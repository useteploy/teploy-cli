{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teploy.github.io/contracts/schema/cloud-servers-envelope.schema.json",
  "title": "`teploy cloud servers --json` (rev 22, cloud-v1): the organization's Teploy Cloud servers, newest first as Teploy Cloud lists them.",
  "type": "object",
  "required": [
    "machine_interface",
    "servers"
  ],
  "properties": {
    "machine_interface": {
      "type": "integer",
      "minimum": 1
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "ip_address",
        "provider",
        "region",
        "size",
        "price_monthly_cents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "Teploy Cloud's server status (active, provisioning, inactive, error, rebooting, suspended). A consumer must treat an unknown value as not ready."
        },
        "ip_address": {
          "type": "string",
          "description": "The server's IPv4; empty until the provider assigns one (Teploy Cloud's 0.0.0.0 placeholder is reported as empty, never as an address)."
        },
        "provider": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "price_monthly_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
