{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teploy.github.io/contracts/schema/events-envelope.schema.json",
  "title": "`teploy events --json` envelope: the per-app server event history (server-authority spec §2.6, rev 10)",
  "type": "object",
  "required": ["machine_interface", "host", "events"],
  "properties": {
    "machine_interface": {"type": "integer", "minimum": 1},
    "host": {"type": "string", "minLength": 1},
    "app": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["v", "id", "seq", "ts", "app", "kind", "outcome", "actor"],
        "properties": {
          "v": {"const": 1},
          "id": {"type": "string", "minLength": 1},
          "seq": {"type": "integer", "minimum": 1},
          "ts": {"type": "string", "format": "date-time"},
          "app": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["started", "succeeded", "failed", "refused"]},
          "release": {"type": "string"},
          "generation": {"type": "integer", "minimum": 0},
          "config_commit": {"type": "string"},
          "actor": {
            "type": "object",
            "required": ["client"],
            "properties": {
              "client": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "cli_version": {"type": "string"},
              "op": {"type": "string"}
            }
          },
          "detail": {"type": "object"}
        }
      }
    }
  }
}
