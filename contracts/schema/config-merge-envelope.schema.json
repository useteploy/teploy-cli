{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teploy.github.io/contracts/schema/config-merge-envelope.schema.json",
  "title": "`teploy config merge --json`: key-level three-way merge of an edit made from base with the current config (read-only, rev 13)",
  "type": "object",
  "required": ["machine_interface", "host", "app", "base", "current", "merged", "conflicts"],
  "properties": {
    "machine_interface": {"type": "integer", "minimum": 1},
    "host": {"type": "string", "minLength": 1},
    "app": {"type": "string", "minLength": 1},
    "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merged": {"type": "string", "description": "The merged teploy.yml; for a conflicting key it holds the edit's value. Save with config set --expect <current>."},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "mine", "current"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "description": "Dotted key both sides changed differently."},
          "mine": {},
          "current": {},
          "mine_removed": {"type": "boolean"},
          "current_removed": {"type": "boolean"}
        }
      }
    }
  }
}
